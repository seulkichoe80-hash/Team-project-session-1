                                        }
                                    ],
                                    [
                                        {
                                            "a": "{{1.rssFields.title}}",
                                            "b": "인공지능",
                                            "o": "text:contain"
                                        }
                                    ],
                                    [
                                        {
                                            "a": "{{1.rssFields.title}}",
                                            "b": "LLM",
                                            "o": "text:contain"
                                        }
                                    ],
                                    [
                                        {
                                            "a": "{{1.rssFields.title}}",
                                            "b": "GPT",
                                            "o": "text:contain"
                                        }
                                    ],
                                    [
                                        {
                                            "a": "{{1.rssFields.title}}",
                                            "b": "Machine Learning",
                                            "o": "text:contain"
                                        }
                                    ],
                                    [
                                        {
                                            "a": "{{1.rssFields.title}}",
                                            "b": "딥러닝",
                                            "o": "text:contain"
                                        }
                                    ],
                                    [
                                        {
                                            "a": "{{1.rssFields.description}}",
                                            "b": "AI",
                                            "o": "text:contain"
                                        }
                                    ],
                                    [
                                        {
                                            "a": "{{1.rssFields.description}}",
                                            "b": "인공지능",
                                            "o": "text:contain"
                                        }
                                    ],
                                    [
                                        {
                                            "a": "{{1.rssFields.description}}",
                                            "b": "LLM",
                                            "o": "text:contain"
                                        }
                                    ],
                                    [
                                        {
                                            "a": "{{1.rssFields.description}}",
                                            "b": "GPT",
                                            "o": "text:contain"
                                        }
                                    ],
                                    [
                                        {
                                            "a": "{{1.rssFields.description}}",
                                            "b": "Machine Learning",
                                            "o": "text:contain"
                                        }
                                    ],
                                    [
                                        {
                                            "a": "{{1.rssFields.description}}",
                                            "b": "딥러닝",
                                            "o": "text:contain"
                                        }
                                    ]
                                ]
                            },
                            "mapper": {
                                "model": "gpt-4o-mini",
                                "top_p": "1",
                                "select": "chat",
                                "messages": [
                                    {
                                        "role": "system",
                                        "content": "당신은 기술 뉴스 요약 전문가입니다.\r\n주어진 기사를 정확히 3줄로 요약하고,\r\n반드시 아래 JSON 형식으로만 응답하세요.\r\n추가 설명이나 마크다운 없이 순수 JSON만 출력하세요.\r\n\r\n응답 형식:\r\n{\r\n  \"summary\": [\"1줄 요약\", \"2줄 요약\", \"3줄 요약\"],\r\n  \"sentiment\": \"positive | neutral | negative\",\r\n  \"tags\": [\"태그1\", \"태그2\"]\r\n}"
                                    },
                                    {
                                        "role": "user",
                                        "content": "아래 기사를 요약해주세요.\r\n- 각 줄은 60자 이내\r\n- 핵심 사실 위주, 추측 금지\r\n\r\n[기사 제목]\r\n{{1.rssFields.title}}\n\r\n[기사 본문]\r\n{{substring(1.rssFields.description; 1; 3000)}}"
                                    }
                                ],
                                "max_tokens": "2048",
                                "temperature": "1",
                                "n_completions": "1",
                                "response_format": "json_object"
                            },
                            "metadata": {
                                "designer": {
                                    "x": 488,
                                    "y": 493
                                }
                            }
                        },
                        {
                            "id": 4,
                            "module": "json:ParseJSON",
                            "version": 1,
                            "parameters": {
                                "type": null
                            },
                            "mapper": {
                                "json": "{{3.choices[1].message.content}}"
                            },
                            "metadata": {
                                "designer": {
                                    "x": 924,
                                    "y": 438
