                "gzip": true,
                "include": [],
                "password": "",
                "username": "",
                "maxResults": 1
            },
            "mapper": {},
            "metadata": {
                "designer": {
                    "x": 0,
                    "y": 150,
                    "name": "[seung] RSS 피드 최신 뉴스 자동 수집 & 1차 중복방지 (매일 09:00 KST)"
